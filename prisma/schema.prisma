// ─────────────────────────────────────────────────────────────────────────────
// MARKETHUB — data model (Phase 1 Foundation + Phase 2 Marketplace + Phase 3
// Shopping + Phase 4 Payments + Phase 5 Vendor Platform + Phase 6 Delivery +
// Phase 7 Admin + Phase 8 Advanced)
//
// Original multi-vendor marketplace, inspired by common e-commerce platform
// functionality — no copied branding, UI, or code from any specific product.
//
// Phase 5 added: VendorOrder fulfilment (paid → processing → shipped →
// delivered) with an immutable VendorOrderStatusHistory; InventoryTransaction
// (a ledger of every stock movement, not just the mutable Product.stock
// counter); WalletLedgerEntry (a vendor's balance is ALWAYS the sum of its
// ledger, never a mutable running total) credited when a VendorOrder is
// marked delivered, split into a gross "sale" entry and a "commission" debit
// so the platform's cut is auditable; Withdrawal (vendor payout requests,
// admin-approved).
//
// Phase 6 adds: Delivery (one job per VendorOrder, created automatically when
// a vendor marks their order "shipped"), self-serve agent assignment (any
// verified, online agent can accept an unassigned job from the pool), an OTP
// proof-of-delivery step (spec §35 — the code is shown on the customer's
// order page since no SMS provider is wired up yet; Phase 8's notification
// system would send it for real), and DeliveryAgentLedgerEntry (mirrors
// WalletLedgerEntry's append-only design). Simplification, called out where
// it's modelled: an agent's delivery earning is a flat amount independent of
// the vendor's own wallet credit — Phase 5 already gives the vendor the full
// delivery fee, so this does not subtract from it; there is no unified
// platform ledger yet to net the two against each other correctly.
//
// Phase 7 adds: product moderation (a vendor's new product now lands in
// "pending_review" and only appears publicly once an admin approves it —
// `Product.moderationNote` mirrors `Vendor.rejectionNote`'s pattern for
// admin-to-vendor feedback), Refund (admin-issued, full-order-amount only —
// partial refunds and calling a real payment gateway's refund API are later
// refinements; when the vendor had already been paid, the exact sale +
// commission ledger entries are reversed), and CmsPage (simple published/
// draft content pages — plain text, no HTML/markdown, rendered at
// /page/[slug]).
//
// Phase 8 adds: Review (one per purchased OrderItem, gated on the owning
// VendorOrder being "delivered"; recomputes Product.ratingAvg/ratingCount
// and Vendor.ratingAvg/ratingCount — those fields existed since Phase 1/2
// as an already-anticipated cache), Coupon (vendor-scoped only — no
// platform-wide coupon spanning multiple vendors' baskets, which would need
// cross-vendor discount proration; usage limits are enforced by counting
// existing VendorOrder rows at redemption time, not a mutable counter),
// FlashSale (a time-boxed override price on one product — every price read
// in cart/checkout/product-page now goes through `effectiveUnitPrice()` in
// src/lib/pricing.ts instead of reading Product.price directly), and
// SupportTicket/SupportMessage (a threaded ticket doubles as this phase's
// "chat" — async messaging, not a real-time socket connection, which would
// be disproportionate new infrastructure for what the spec item needs).
// "Recommendations" needed no new schema — related-products and trending
// are query-only, reusing Product.viewCount which was already tracked.
//
// PROVIDER: `postgresql` (Neon, matches the rest of the DKay portfolio).
//
// MULTI-TENANCY: every vendor-owned row carries `vendorId`. No query may
// cross vendors. Platform staff are scoped by role, not by vendor.
//
// MONEY: every price is an INTEGER minor unit — pesewas (1 GHS = 100 pesewas)
// — so financial math is always exact. See src/lib/money.ts.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity, roles & sessions ──────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  avatarUrl       String?
  // Coarse account kind for routing the UI. Fine-grained access = roles + perms.
  kind            String    @default("customer") // customer | vendor | delivery_agent | staff
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  // Two-factor auth (TOTP, RFC 6238) — staff accounts only (super_admin,
  // platform_admin, support_agent, finance_officer), enforced at the API
  // layer, not by a schema constraint. mfaPendingSecret holds a
  // freshly-generated secret during enrollment, before the user has proven
  // they can produce a valid code; it's promoted to mfaSecret (and cleared)
  // only on confirmation, so an enrollment nobody finishes never silently
  // becomes "protected but nobody has the secret."
  mfaPendingSecret String?
  mfaSecret        String?
  mfaEnabledAt     DateTime?
  mfaBackupCodes   String    @default("[]") // JSON string[] of sha256-hashed single-use codes
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]
  vendorStaff    VendorStaff[]
  ownedVendors   Vendor[]        @relation("VendorOwner")
  deliveryAgent  DeliveryAgent?
  addresses      Address[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orders         Order[]
  reviews        Review[]
  ticketsOpened  SupportTicket[]   @relation("TicketsOpened")
  ticketsAssigned SupportTicket[]  @relation("TicketsAssigned")
  supportMessages SupportMessage[]
}

// Global permission catalogue rows (seeded from src/lib/rbac.ts PERMISSIONS).
model Permission {
  key         String           @id // e.g. "vendors.manage"
  description String
  roles       RolePermission[]
}

// A named role. `scope` = "platform" or "vendor". System roles are seeded and
// cannot be deleted.
model Role {
  id        String   @id @default(cuid())
  key       String // super_admin | platform_admin | support_agent | finance_officer | vendor_owner | vendor_staff | delivery_agent | customer
  name      String
  scope     String   @default("platform") // platform | vendor
  isSystem  Boolean  @default(true)
  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([key])
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

// Grant of a role to a user. `vendorId` is set for vendor-scoped roles.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  vendorId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, vendorId])
  @@index([vendorId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  jti       String    @unique
  userAgent String    @default("")
  ip        String    @default("")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Vendors (stores) ─────────────────────────────────────────────────────────

model Vendor {
  id            String   @id @default(cuid())
  slug          String   @unique
  businessName  String
  ownerId       String
  description   String   @default("")
  category      String   @default("") // free-text business category until Phase 2 Category model exists
  logoUrl       String?
  bannerUrl     String?
  phone         String   @default("")
  email         String   @default("")
  // Location
  addressLine   String   @default("")
  area          String   @default("")
  city          String   @default("")
  region        String   @default("")
  // Onboarding / moderation
  status        String   @default("pending") // pending | under_review | approved | rejected | suspended
  rejectionNote String   @default("")
  // Settlement (used from Phase 5 onward; collected at onboarding per spec §23)
  payoutBank    String   @default("")
  payoutAccount String   @default("")
  commissionBps Int? // null = platform default
  // Delivery — flat fee per order to this vendor, pesewas. Region/distance
  // -based pricing (spec §74) is a later phase; this keeps checkout honest
  // without pretending distance pricing exists yet.
  baseDeliveryFee Int    @default(1500)
  // Ratings cache (populated from Phase 8 reviews)
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       User              @relation("VendorOwner", fields: [ownerId], references: [id])
  staff       VendorStaff[]
  userRoles   UserRole[]
  products    Product[]
  vendorOrders VendorOrder[]
  walletLedger WalletLedgerEntry[]
  withdrawals  Withdrawal[]
  reviews      Review[]
  coupons      Coupon[]
  flashSales   FlashSale[]

  @@index([status])
  @@index([city, region])
}

model VendorStaff {
  id        String   @id @default(cuid())
  vendorId  String
  userId    String
  roleKey   String   @default("vendor_staff") // vendor_owner | vendor_staff
  jobTitle  String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
  @@index([userId])
}

// ── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  imageUrl  String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  vendorId    String
  categoryId  String
  brandId     String?
  name        String
  sku         String   @default("")
  description String   @default("")
  shortDescription String @default("")
  // Money — integer pesewas, never float.
  price         Int
  discountPrice Int?
  stock         Int      @default(0)
  lowStockThreshold Int  @default(5)
  weight        Float?   // kg
  // JSON string arrays/objects — keeps the schema provider-portable (no
  // native arrays/enums), matching the rest of the portfolio.
  images         String  @default("[]") // JSON string[] of image URLs
  tags           String  @default("[]") // JSON string[]
  specifications String  @default("{}") // JSON Record<string,string>
  // draft | pending_review | active | rejected | out_of_stock | suspended.
  // A vendor can only set draft/pending_review/out_of_stock themselves — a
  // new product starts at pending_review and only an admin can move it to
  // active/rejected/suspended (Phase 7 moderation gate).
  status      String   @default("pending_review")
  moderationNote String @default("") // admin's note on rejection/suspension, shown to the vendor
  isFeatured  Boolean  @default(false)
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  brand    Brand?          @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  inventoryTransactions InventoryTransaction[]
  reviews       Review[]
  flashSales    FlashSale[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([price])
}

// Simple key-value variant (e.g. "Red / M") rather than a full attribute
// matrix — keeps Phase 2 lean; a dedicated attribute system can replace this
// later without touching Order/Cart code, since both reference variant ids.
model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  label         String  // e.g. "Red / Medium", "128GB"
  sku           String  @default("")
  priceOverride Int?    // pesewas; null = use Product.price
  stock         Int     @default(0)
  imageUrl      String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ── Addresses, cart & wishlist ──────────────────────────────────────────────

model Address {
  id                   String   @id @default(cuid())
  userId               String
  label                String   @default("home") // home | office | other
  recipientName        String
  phone                String
  region               String
  city                 String
  area                 String   @default("")
  streetLine           String   @default("")
  gpsAddress           String   @default("") // Ghana Post GPS or similar, optional
  deliveryInstructions String   @default("")
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// Flat per-user cart line — no separate Cart wrapper: a guest-cart-merge
// feature would need one, but Phase 3 requires login to shop, so it would be
// unused ceremony today.
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ── Orders ───────────────────────────────────────────────────────────────────

// The whole customer purchase, spanning every vendor in the cart at checkout
// time. Split into one VendorOrder per vendor (spec §22) so each vendor only
// ever sees their own slice.
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique // e.g. MH-7K2M9Q
  customerId      String
  addressId       String
  clientRequestId String   @unique // idempotency key — prevents duplicate orders on double-submit
  // Address snapshot — the live Address row may change or be deleted later;
  // the order must keep showing what was true at checkout time.
  recipientName        String
  phone                String
  region               String
  city                 String
  area                 String
  streetLine           String
  deliveryInstructions String
  subtotal Int // pesewas, sum of vendor subtotals
  deliveryFee Int // pesewas, sum of vendor delivery fees
  discountAmount Int @default(0) // pesewas, sum of vendor coupon discounts (Phase 8)
  total    Int // pesewas
  status   String   @default("pending_payment") // pending_payment | paid | cancelled (Phase 5 adds processing/shipped/delivered)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     User          @relation(fields: [customerId], references: [id])
  address      Address       @relation(fields: [addressId], references: [id])
  vendorOrders VendorOrder[]
  payment      Payment?

  @@index([customerId])
  @@index([status])
}

// One vendor's slice of an Order — what that vendor sees and fulfils
// independently.
model VendorOrder {
  id          String   @id @default(cuid())
  orderId     String
  vendorId    String
  subtotal    Int // pesewas
  deliveryFee Int // pesewas
  discountAmount Int   @default(0) // pesewas, this vendor's coupon discount (Phase 8)
  couponId    String?
  total       Int // pesewas
  // pending_payment | paid | processing | shipped | delivered | cancelled |
  // refunded (admin-issued, Phase 7 — see Refund)
  status      String   @default("pending_payment")
  walletCreditedAt DateTime? // set once, when this vendor's earnings hit their wallet
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order    Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor   Vendor                     @relation(fields: [vendorId], references: [id])
  coupon   Coupon?                    @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  history  VendorOrderStatusHistory[]
  delivery Delivery?
  refunds  Refund[]

  @@index([orderId])
  @@index([vendorId])
  @@index([couponId])
}

// Immutable fulfilment timeline (spec §21) — append-only, one row per
// transition, so "what happened and when" is never lost to an update.
model VendorOrderStatusHistory {
  id            String   @id @default(cuid())
  vendorOrderId String
  status        String
  note          String   @default("")
  actorId       String?
  actorName     String   @default("")
  createdAt     DateTime @default(now())

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
}

model OrderItem {
  id            String @id @default(cuid())
  vendorOrderId String
  productId     String
  variantId     String?
  // Snapshots — never re-read the live Product for historical orders.
  nameSnapshot  String
  imageSnapshot String  @default("")
  priceSnapshot Int // pesewas, per unit
  quantity      Int

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  review      Review?

  @@index([vendorOrderId])
}

// ── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  provider    String   @default("") // mock | paystack
  method      String   @default("card") // card | momo
  momoNetwork String   @default("") // mtn | telecel | airteltigo
  reference   String   @unique // our reference, passed to the gateway
  amount      Int // pesewas — authoritative expected amount (= Order.total)
  currency    String   @default("GHS")
  status      String   @default("PENDING") // PENDING | PROCESSING | SUCCESSFUL | FAILED | CANCELLED
  gatewayRef       String   @default("")
  authorizationUrl String @default("")
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
}

// Append-only log of every initiate/verify/webhook attempt against a
// Payment — an audit trail independent of the mutable Payment row itself.
model PaymentTransaction {
  id        String   @id @default(cuid())
  paymentId String
  kind      String // initiate | verify | webhook
  status    String
  amount    Int      @default(0)
  raw       String   @default("{}") // JSON — provider response, secrets stripped
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// Idempotency + replay protection for gateway webhooks — a provider may
// legitimately send the same event more than once.
model PaymentWebhook {
  id          String    @id @default(cuid())
  provider    String
  eventId     String // provider event id / dedupe key
  signature   String    @default("")
  processedAt DateTime?
  payload     String    @default("{}")
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

// ── Vendor platform: inventory, wallet, withdrawals ─────────────────────────

// A ledger of every stock movement — Product.stock is a fast mutable
// counter for reads, this is the durable record of why it changed
// (spec §27). Never inferred; always written alongside the stock update.
model InventoryTransaction {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  type      String // sale | return | restock | adjustment
  quantity  Int // signed: negative for sale, positive for return/restock
  note      String   @default("")
  orderId   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// A vendor's balance is ALWAYS the sum of this ledger — never a mutable
// running total (spec §30). "sale" and "commission" are written as two
// separate entries per delivered order so the platform's cut is auditable.
model WalletLedgerEntry {
  id            String   @id @default(cuid())
  vendorId      String
  type          String // sale | commission | withdrawal | withdrawal_reversal | adjustment
  amount        Int // pesewas, signed (credit positive, debit negative)
  balanceAfter  Int // pesewas — snapshot of the running balance at write time
  vendorOrderId String?
  withdrawalId  String?
  note          String   @default("")
  createdAt     DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model Withdrawal {
  id            String    @id @default(cuid())
  vendorId      String
  amount        Int // pesewas
  status        String    @default("pending") // pending | approved | rejected | completed
  // Payout destination snapshot at request time — the live Vendor row may change later.
  payoutBank    String
  payoutAccount String
  note          String    @default("")
  reviewNote    String    @default("")
  processedById String?
  requestedAt   DateTime  @default(now())
  processedAt   DateTime?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

// ── Delivery agents ──────────────────────────────────────────────────────────

model DeliveryAgent {
  id            String   @id @default(cuid())
  userId        String   @unique
  status        String   @default("offline") // offline | online | on_delivery
  verification  String   @default("pending") // pending | verified | rejected
  vehicleType   String   @default("motorbike") // bike | motorbike | car | van | on_foot
  licenseNumber String   @default("")
  city          String   @default("")
  region        String   @default("")
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  ledger     DeliveryAgentLedgerEntry[]

  @@index([status, verification])
}

// One delivery job per VendorOrder — created automatically when a vendor
// marks their order "shipped". Sits in the unassigned pool until a verified,
// online agent accepts it.
model Delivery {
  id            String    @id @default(cuid())
  vendorOrderId String    @unique
  agentId       String?
  // pending_assignment | assigned | picked_up | out_for_delivery | delivered | failed
  status        String    @default("pending_assignment")
  // Proof of delivery (spec §35) — a 4-digit code the customer sees on their
  // order page and reads out to the agent at handoff. No SMS provider is
  // wired up yet (Phase 8), so it's surfaced in-app instead of texted.
  otpCode       String
  otpVerifiedAt DateTime?
  agentEarning  Int // pesewas — snapshotted from VendorOrder.deliveryFee at assignment time
  failureReason String    @default("")
  assignedAt        DateTime?
  pickedUpAt         DateTime?
  outForDeliveryAt   DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendorOrder VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  agent       DeliveryAgent? @relation(fields: [agentId], references: [id])

  @@index([status])
  @@index([agentId])
}

// A delivery agent's balance is ALWAYS the sum of this ledger — same
// discipline as WalletLedgerEntry for vendors.
model DeliveryAgentLedgerEntry {
  id           String   @id @default(cuid())
  agentId      String
  type         String // delivery_earning | adjustment
  amount       Int // pesewas, signed
  balanceAfter Int // pesewas
  deliveryId   String?
  note         String   @default("")
  createdAt    DateTime @default(now())

  agent DeliveryAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// ── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String   @default("")
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  meta       String   @default("{}") // JSON string
  ip         String   @default("")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ── Refunds (Phase 7) ────────────────────────────────────────────────────────

// Admin-issued, full-order-amount only (spec's later phases can add partial
// refunds and a real gateway refund call). Reverses the vendor's wallet
// credit if one was already made, via the same paired sale/commission
// ledger discipline `creditVendorForDelivery` uses — never a silent balance
// edit.
model Refund {
  id              String   @id @default(cuid())
  vendorOrderId   String
  amount          Int // pesewas — always equals the VendorOrder's total for now
  reason          String
  walletReversed  Boolean  @default(false) // true if the vendor had already been paid and was clawed back
  processedById   String?
  processedByName String   @default("")
  createdAt       DateTime @default(now())

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
}

// ── CMS (Phase 7) ────────────────────────────────────────────────────────────

// Plain-text content pages (About, Terms, FAQ, ...) an admin can publish
// without a deploy. Deliberately no HTML/markdown rendering yet — content is
// rendered as paragraphs to keep the platform's XSS surface at zero for
// admin-authored copy.
model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @default("")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

// ── Reviews (Phase 8) ────────────────────────────────────────────────────────

// One review per purchased line item — `orderItemId` both proves the
// purchase and gates duplicate reviews of the same purchase (a customer who
// buys the same product twice may review each purchase separately). Only
// creatable once the owning VendorOrder is "delivered".
model Review {
  id              String    @id @default(cuid())
  productId       String
  vendorId        String // denormalized for cheap vendor-scoped listing/moderation
  customerId      String
  orderItemId     String    @unique
  rating          Int // 1-5
  title           String    @default("")
  body            String    @default("")
  status          String    @default("published") // published | hidden (admin moderation)
  vendorReply     String    @default("")
  vendorRepliedAt DateTime?
  createdAt       DateTime  @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customer  User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([vendorId])
  @@index([status])
}

// ── Promotions: coupons & flash sales (Phase 8) ─────────────────────────────

// Vendor-scoped only — a platform-wide coupon spanning multiple vendors'
// baskets would need cross-vendor discount proration, which is a real
// refinement, not a Phase 8 concern (called out in README). Usage limits
// are enforced by counting existing VendorOrder rows referencing this
// coupon at redemption time, never a mutable counter, matching the
// project's ledger-truth discipline elsewhere.
model Coupon {
  id               String    @id @default(cuid())
  vendorId         String
  code             String // stored upper-cased
  type             String // percent | fixed
  value            Int // percent: 1-100; fixed: pesewas
  minSubtotal      Int       @default(0) // pesewas — vendor's basket subtotal must reach this
  maxDiscount      Int? // pesewas cap, percent coupons only
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int? // total redemptions across all customers; null = unlimited
  perCustomerLimit Int? // null = unlimited
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorOrders VendorOrder[]

  @@unique([vendorId, code])
  @@index([vendorId])
}

// A time-boxed override price on one product. The effective price a
// customer pays (cart, checkout, product page) is always
// `effectiveUnitPrice()` in src/lib/pricing.ts, never Product.price/
// discountPrice read directly — that's the one place flash-sale pricing is
// allowed to matter.
model FlashSale {
  id        String   @id @default(cuid())
  vendorId  String
  productId String
  salePrice Int // pesewas
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([vendorId])
  @@index([startsAt, endsAt])
}

// ── Support (Phase 8) ────────────────────────────────────────────────────────

// A threaded support ticket doubles as this phase's "chat" — async
// messaging rather than a real-time socket connection, which would be a
// disproportionate amount of new infrastructure for what the spec's Phase 8
// item actually needs. A customer (or vendor/agent) opens one; staff with
// `disputes.manage` (support_agent, platform_admin, finance_officer) work
// the queue.
model SupportTicket {
  id           String   @id @default(cuid())
  subject      String
  category     String   @default("general") // general | order | payment | vendor | other
  status       String   @default("open") // open | pending | resolved | closed
  openedById   String
  openedByName String   @default("")
  assignedToId String?
  orderNumber  String   @default("") // optional free-text reference, not a hard FK
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  openedBy   User             @relation("TicketsOpened", fields: [openedById], references: [id], onDelete: Cascade)
  assignedTo User?            @relation("TicketsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([status])
  @@index([openedById])
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String?
  authorName String   @default("")
  authorRole String   @default("customer") // customer | staff
  body       String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}
