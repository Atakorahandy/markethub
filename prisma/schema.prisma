// ─────────────────────────────────────────────────────────────────────────────
// MARKETHUB — data model (Phase 1 Foundation + Phase 2 Marketplace + Phase 3 Shopping)
//
// Original multi-vendor marketplace, inspired by common e-commerce platform
// functionality — no copied branding, UI, or code from any specific product.
//
// Phase 3 adds: addresses, cart, wishlist, and orders (with per-vendor
// splitting — see VendorOrder). Orders are created at checkout WITHOUT a real
// payment step: status starts at "pending_payment" and stays there. Payment
// gateway integration (Mobile Money/card, verification, webhooks) that
// transitions orders to "paid" is Phase 4, deliberately not modelled yet.
// Vendor-side order fulfilment (Phase 5) and delivery assignment (Phase 6)
// are also not modelled yet — see README.md.
//
// PROVIDER: `postgresql` (Neon, matches the rest of the DKay portfolio).
//
// MULTI-TENANCY: every vendor-owned row carries `vendorId`. No query may
// cross vendors. Platform staff are scoped by role, not by vendor.
//
// MONEY: every price is an INTEGER minor unit — pesewas (1 GHS = 100 pesewas)
// — so financial math is always exact. See src/lib/money.ts.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity, roles & sessions ──────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  avatarUrl       String?
  // Coarse account kind for routing the UI. Fine-grained access = roles + perms.
  kind            String    @default("customer") // customer | vendor | delivery_agent | staff
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]
  vendorStaff    VendorStaff[]
  ownedVendors   Vendor[]        @relation("VendorOwner")
  deliveryAgent  DeliveryAgent?
  addresses      Address[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orders         Order[]
}

// Global permission catalogue rows (seeded from src/lib/rbac.ts PERMISSIONS).
model Permission {
  key         String           @id // e.g. "vendors.manage"
  description String
  roles       RolePermission[]
}

// A named role. `scope` = "platform" or "vendor". System roles are seeded and
// cannot be deleted.
model Role {
  id        String   @id @default(cuid())
  key       String // super_admin | platform_admin | support_agent | finance_officer | vendor_owner | vendor_staff | delivery_agent | customer
  name      String
  scope     String   @default("platform") // platform | vendor
  isSystem  Boolean  @default(true)
  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([key])
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

// Grant of a role to a user. `vendorId` is set for vendor-scoped roles.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  vendorId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, vendorId])
  @@index([vendorId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  jti       String    @unique
  userAgent String    @default("")
  ip        String    @default("")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Vendors (stores) ─────────────────────────────────────────────────────────

model Vendor {
  id            String   @id @default(cuid())
  slug          String   @unique
  businessName  String
  ownerId       String
  description   String   @default("")
  category      String   @default("") // free-text business category until Phase 2 Category model exists
  logoUrl       String?
  bannerUrl     String?
  phone         String   @default("")
  email         String   @default("")
  // Location
  addressLine   String   @default("")
  area          String   @default("")
  city          String   @default("")
  region        String   @default("")
  // Onboarding / moderation
  status        String   @default("pending") // pending | under_review | approved | rejected | suspended
  rejectionNote String   @default("")
  // Settlement (used from Phase 5 onward; collected at onboarding per spec §23)
  payoutBank    String   @default("")
  payoutAccount String   @default("")
  commissionBps Int? // null = platform default
  // Delivery — flat fee per order to this vendor, pesewas. Region/distance
  // -based pricing (spec §74) is a later phase; this keeps checkout honest
  // without pretending distance pricing exists yet.
  baseDeliveryFee Int    @default(1500)
  // Ratings cache (populated from Phase 8 reviews)
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       User              @relation("VendorOwner", fields: [ownerId], references: [id])
  staff       VendorStaff[]
  userRoles   UserRole[]
  products    Product[]
  vendorOrders VendorOrder[]

  @@index([status])
  @@index([city, region])
}

model VendorStaff {
  id        String   @id @default(cuid())
  vendorId  String
  userId    String
  roleKey   String   @default("vendor_staff") // vendor_owner | vendor_staff
  jobTitle  String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
  @@index([userId])
}

// ── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  imageUrl  String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  vendorId    String
  categoryId  String
  brandId     String?
  name        String
  sku         String   @default("")
  description String   @default("")
  shortDescription String @default("")
  // Money — integer pesewas, never float.
  price         Int
  discountPrice Int?
  stock         Int      @default(0)
  lowStockThreshold Int  @default(5)
  weight        Float?   // kg
  // JSON string arrays/objects — keeps the schema provider-portable (no
  // native arrays/enums), matching the rest of the portfolio.
  images         String  @default("[]") // JSON string[] of image URLs
  tags           String  @default("[]") // JSON string[]
  specifications String  @default("{}") // JSON Record<string,string>
  status      String   @default("active") // draft | active | out_of_stock | suspended
  isFeatured  Boolean  @default(false)
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  brand    Brand?          @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([price])
}

// Simple key-value variant (e.g. "Red / M") rather than a full attribute
// matrix — keeps Phase 2 lean; a dedicated attribute system can replace this
// later without touching Order/Cart code, since both reference variant ids.
model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  label         String  // e.g. "Red / Medium", "128GB"
  sku           String  @default("")
  priceOverride Int?    // pesewas; null = use Product.price
  stock         Int     @default(0)
  imageUrl      String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ── Addresses, cart & wishlist ──────────────────────────────────────────────

model Address {
  id                   String   @id @default(cuid())
  userId               String
  label                String   @default("home") // home | office | other
  recipientName        String
  phone                String
  region               String
  city                 String
  area                 String   @default("")
  streetLine           String   @default("")
  gpsAddress           String   @default("") // Ghana Post GPS or similar, optional
  deliveryInstructions String   @default("")
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// Flat per-user cart line — no separate Cart wrapper: a guest-cart-merge
// feature would need one, but Phase 3 requires login to shop, so it would be
// unused ceremony today.
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ── Orders ───────────────────────────────────────────────────────────────────

// The whole customer purchase, spanning every vendor in the cart at checkout
// time. Split into one VendorOrder per vendor (spec §22) so each vendor only
// ever sees their own slice.
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique // e.g. MH-7K2M9Q
  customerId      String
  addressId       String
  clientRequestId String   @unique // idempotency key — prevents duplicate orders on double-submit
  // Address snapshot — the live Address row may change or be deleted later;
  // the order must keep showing what was true at checkout time.
  recipientName        String
  phone                String
  region               String
  city                 String
  area                 String
  streetLine           String
  deliveryInstructions String
  subtotal Int // pesewas, sum of vendor subtotals
  deliveryFee Int // pesewas, sum of vendor delivery fees
  total    Int // pesewas
  status   String   @default("pending_payment") // pending_payment | cancelled (Phase 4 adds paid/processing/...)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     User          @relation(fields: [customerId], references: [id])
  address      Address       @relation(fields: [addressId], references: [id])
  vendorOrders VendorOrder[]

  @@index([customerId])
  @@index([status])
}

// One vendor's slice of an Order — what that vendor sees and fulfils
// independently (fulfilment UI itself is Phase 5).
model VendorOrder {
  id          String   @id @default(cuid())
  orderId     String
  vendorId    String
  subtotal    Int // pesewas
  deliveryFee Int // pesewas
  total       Int // pesewas
  status      String   @default("pending_payment") // mirrors Order.status until Phase 4/5 diverge them
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor Vendor      @relation(fields: [vendorId], references: [id])
  items  OrderItem[]

  @@index([orderId])
  @@index([vendorId])
}

model OrderItem {
  id            String @id @default(cuid())
  vendorOrderId String
  productId     String
  variantId     String?
  // Snapshots — never re-read the live Product for historical orders.
  nameSnapshot  String
  imageSnapshot String  @default("")
  priceSnapshot Int // pesewas, per unit
  quantity      Int

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([vendorOrderId])
}

// ── Delivery agents ──────────────────────────────────────────────────────────

model DeliveryAgent {
  id            String   @id @default(cuid())
  userId        String   @unique
  status        String   @default("offline") // offline | online | on_delivery
  verification  String   @default("pending") // pending | verified | rejected
  vehicleType   String   @default("motorbike") // bike | motorbike | car | van | on_foot
  licenseNumber String   @default("")
  city          String   @default("")
  region        String   @default("")
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, verification])
}

// ── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String   @default("")
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  meta       String   @default("{}") // JSON string
  ip         String   @default("")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
