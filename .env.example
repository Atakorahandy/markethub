# ─────────────────────────────────────────────────────────────
# MARKETHUB — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Database — PostgreSQL (Neon recommended, matches the rest of the DKay portfolio).
# Pooled connection string, sslmode=require:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/markethub?sslmode=require&pgbouncer=true"

# Auth secrets — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
ACCESS_TOKEN_TTL="900"          # seconds (15 min)
REFRESH_TOKEN_TTL="2592000"     # seconds (30 days)

# App
APP_NAME="MarketHub"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Security / rate limiting
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX="120"

# Seed / default super admin (used by `npm run db:seed`)
SEED_SUPERADMIN_EMAIL="admin@markethub.app"
SEED_SUPERADMIN_PASSWORD="ChangeMe!Admin123"

# ── Payments — provider-agnostic. MOCK needs no keys (default in dev, always works).
#    Paystack Ghana handles cards + Mobile Money (MTN / Telecel / AirtelTigo).
#    To go live: set PAYMENT_PROVIDER=paystack, add PAYSTACK_SECRET_KEY, and in the
#    Paystack dashboard (Settings → API Keys & Webhooks) set the webhook URL to
#    https://<your-domain>/api/payments/webhook and enable the charge.* events.
PAYMENT_PROVIDER="mock"                 # mock | paystack
PAYMENT_CURRENCY="GHS"
PAYSTACK_SECRET_KEY=""                  # sk_test_... / sk_live_...  (also signs webhooks)
PAYSTACK_PUBLIC_KEY=""                  # pk_test_... / pk_live_...
PAYSTACK_WEBHOOK_SECRET=""              # optional — defaults to PAYSTACK_SECRET_KEY

# ── Not wired up yet (later phases — kept here so the shape is known early) ──
# Object storage (Phase 2+): CLOUDINARY_URL or S3 credentials for product/vendor images
# SMS / Email (Phase 8+): SMS_API_KEY, EMAIL_API_KEY, MAIL_FROM
